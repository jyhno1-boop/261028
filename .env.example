# Phase 2(Firebase 연동)에서 사용할 환경변수 목록입니다.
# 사용법: 이 파일을 복사해 .env.local 파일을 만들고, Firebase 콘솔에서 받은 값을 채워 넣으세요.
# .env.local 파일은 GitHub에 올라가지 않습니다. Netlify에는 사이트 설정 > Environment variables에 따로 입력합니다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
