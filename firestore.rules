// Firestore 보안 규칙
// Firebase 콘솔 > Firestore Database > 규칙(Rules) 탭에 이 내용을 그대로 붙여 넣고 "게시"를 누르세요.
//
// 요약
//  - 연구·수업 자료·논문·댓글: 누구나 읽기 가능
//  - 쓰기(추가·수정·삭제): 관리자만 가능
//  - 관리자 목록(admins): Firebase 콘솔에서만 추가·삭제 (사이트에서는 본인 확인용 읽기만)
//  - 그 밖의 모든 경로: 읽기·쓰기 금지

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // 관리자: 구글 이메일이 인증되었고, admins/{이메일} 문서가 존재하는 사용자
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    match /research/{researchId} {
      allow read: if true;
      allow write: if isAdmin();

      // 토론 댓글: Phase 3에서 로그인 사용자 작성 규칙을 추가할 예정
      match /comments/{commentId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /publications/{publicationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{email} {
      // 로그인한 본인의 관리자 여부만 확인할 수 있음
      allow read: if isSignedIn() && request.auth.token.email == email;
      allow write: if false;
    }
  }
}
